+def jolt_bounce(rng):
+    dur = 0.45
+    t = t_axis(dur)
+    # "بوينغ" مطاطي: نغمة هابطة صاعدة مع اهتزاز
+    f = 320 + 280 * np.exp(-6 * t) * np.cos(2 * np.pi * 7 * t) + 160 * np.exp(-3 * t)
+    phase = 2 * np.pi * np.cumsum(f) / SR
+    boing = np.sin(phase) * env_ad(len(t), 0.002, 0.3, 4)
