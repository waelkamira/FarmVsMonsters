+    const width = layer.width || 3;
+    const draw = () => {
+      g.clear();
+      for (let b = 0; b < layer.count; b += 1) {
+        const startX = ctx.x + (layer.fromTop ? rand(-8, 8) : rand(-34, 34));
+        const startY = ctx.y - layer.height * (layer.fromTop ? 1 : rand(0.55, 1));
+        const endX = ctx.x + rand(-6, 6);
+        const endY = ctx.y + 8;
