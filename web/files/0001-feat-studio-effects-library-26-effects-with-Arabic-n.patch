+      .setDepth(this.#depth(ctx))
+      .setBlendMode(ADD_BLEND);
+    this.#animate(layer.life, (t) => {
+      if (!glow.active) return;
+      glow.setScale(0.8 + t * 0.9);
+      glow.setAlpha(0.85 * (1 - t));
+    }, () => { glow.destroy(); this.#release(1); });
+  }
+
+  #bolt(layer, ctx) {
+    if (!this.#reserve(1)) return;
