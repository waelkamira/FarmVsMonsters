+    const angle = (rotationDeg * Math.PI) / 180 + (i * Math.PI) / points;
+    out.push([Number((cx + Math.cos(angle) * radius).toFixed(2)), Number((cy + Math.sin(angle) * radius).toFixed(2))]);
+  }
+  return out;
