+  "poof-vanish": () => `${cloud(2)}<polygon ${W("#ffe066")} points="${pts(star(48, 14, 8, 3, 4))}"/><polygon ${W("#ffe066")} points="${pts(star(14, 16, 6, 2.5, 4))}"/>`,
