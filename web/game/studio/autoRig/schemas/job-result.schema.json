{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farmvsmonsters.local/schemas/job-result.schema.json",
  "title": "FarmVsMonsters Auto-Rig Job Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "status",
    "stages",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "needs-review",
        "failed",
        "completed"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "needs-review",
              "failed",
              "skipped"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "errorCode": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source",
              "part",
              "mask",
              "geometry",
              "blend",
              "preview",
              "sprite-sheet",
              "atlas",
              "rig-profile",
              "combat-config",
              "validation-report"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
