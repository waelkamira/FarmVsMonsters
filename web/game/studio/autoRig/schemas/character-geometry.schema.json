{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farmvsmonsters.local/schemas/character-geometry.schema.json",
  "title": "FarmVsMonsters Intermediate Character Geometry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "characterId",
    "coordinateSpace",
    "canvas",
    "parts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "characterId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "xAxis",
        "yAxis",
        "unit"
      ],
      "properties": {
        "origin": {
          "const": "top-left"
        },
        "xAxis": {
          "const": "right"
        },
        "yAxis": {
          "const": "down"
        },
        "unit": {
          "const": "pixel"
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "rigType",
          "bounds",
          "pivot",
          "zIndex",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,63}$"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "rigType": {
            "enum": [
              "rigid",
              "deform"
            ]
          },
          "image": {
            "type": "string"
          },
          "mask": {
            "type": "string"
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "pivot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "parentPartId": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggestedBoneId": {
            "type": [
              "string",
              "null"
            ]
          },
          "zIndex": {
            "type": "integer"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "landmarks": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "x",
                "y",
                "confidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 64
                },
                "kind": {
                  "enum": [
                    "joint",
                    "attachment",
                    "tip",
                    "root",
                    "custom"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "boneSuggestions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "head",
          "tail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,63}$"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "head": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "tail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
