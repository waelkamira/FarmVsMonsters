{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farmvsmonsters.local/schemas/auto-rig-job.schema.json",
  "title": "FarmVsMonsters Auto-Rig Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "characterId",
    "characterType",
    "source",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "characterId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "characterType": {
      "enum": [
        "plant",
        "biped",
        "quadruped",
        "flying",
        "multi_part_boss",
        "other"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(png|webp|jpg|jpeg)$"
        },
        "expectedWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "expectedHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "frameCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "rigTemplate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "templateId",
        "version"
      ],
      "properties": {
        "templateId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "segmentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "provided",
            "ai",
            "manual",
            "hybrid"
          ],
          "default": "hybrid"
        },
        "provider": {
          "type": "string",
          "maxLength": 80
        },
        "reconstructHiddenParts": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sprite-sheet",
              "skeletal-v1"
            ]
          }
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 12
        },
        "animations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,63}$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
