# Supabase project settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Private FarmVsMonsters asset studio
STUDIO_ALLOWED_IPS=203.0.113.10
STUDIO_ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_ADMIN_PASSWORD
# Separate random HMAC signing secret; never reuse STUDIO_ADMIN_TOKEN
STUDIO_SESSION_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET
# Required in production for shared login throttling (Upstash Redis REST)
STUDIO_RATE_LIMIT_REDIS_REST_URL=https://YOUR_UPSTASH_REDIS_REST_URL
STUDIO_RATE_LIMIT_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN
STUDIO_STORAGE_DRIVER=github
STUDIO_GITHUB_REPOSITORY=waelkamira/FarmVsMonsters
STUDIO_GITHUB_BRANCH=studio/assets
STUDIO_GITHUB_TOKEN=YOUR_GITHUB_TOKEN