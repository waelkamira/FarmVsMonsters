# Supabase project settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Private FarmVsMonsters asset studio
STUDIO_ADMIN_TOKEN=replace-with-a-long-random-secret
# local: development filesystem | github: versioned remote uploads
STUDIO_STORAGE_DRIVER=local
STUDIO_GITHUB_REPOSITORY=waelkamira/FarmVsMonsters
STUDIO_GITHUB_BRANCH=studio/assets
STUDIO_GITHUB_TOKEN=replace-with-a-fine-grained-token-with-contents-write